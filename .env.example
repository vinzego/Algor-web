# Runtime
NODE_ENV=production
PORT=3001
SITE_ORIGIN=https://algor.studio
# Set this to the number of trusted reverse proxies (for example 1), only when deployed behind one.
TRUST_PROXY=

# Durable contact-form storage
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Confirmation email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Algor Studio <info@algor.studio>"

# Optional local plaintext backup. Keep disabled unless operationally required.
SAVE_LOCAL_CSV=false
# Required only if the private CSV export endpoint is enabled/used. Use at least 32 random bytes.
ADMIN_SECRET_KEY=
